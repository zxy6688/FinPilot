finpilot.cn {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
    }
    request_body {
        max_size 2MB
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8004
    }
    handle {
        root * /opt/finpilot/current/frontend/dist
        try_files {path} /index.html
        file_server
    }
}
www.finpilot.cn {
    redir https://finpilot.cn{uri} permanent
}
